# ============================================================
# e-SIMANTRI — contoh variabel lingkungan
# Salin berkas ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit .env berisi kredensial sungguhan.
# ============================================================

# --- Basis data ---------------------------------------------
# Demo lokal (SQLite). Berkas DB tidak boleh ikut ke git:
DATABASE_URL="file:../db/custom.db"

# Produksi Supabase (PostgreSQL):
# - DATABASE_URL = koneksi POOLED (port 6543, pgbouncer) untuk aplikasi di Vercel
# - DIRECT_URL   = koneksi LANGSUNG (port 5432) untuk prisma db push / migrasi
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Keamanan ------------------------------------------------
# Rahasia penandatanganan sesi portal pasien — WAJIB diisi di produksi.
# Buat dengan: openssl rand -hex 32
PORTAL_SESSION_SECRET=""

# Rahasia endpoint pekerja antrean SATUSEHAT untuk cron (opsional).
# Vercel Cron otomatis mengirim header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
